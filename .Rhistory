"Jhon Wilfer Toral Polo", "Johan Andres Tordecilla Medina"),
Nota = c(95, 90, 85, 88, 70, 85, 90, 85, 92, 90)
)
notas_tanda_2 <- data.frame(
Nombre = c("María José Berrío Pérez", "Luis Alejandro Cardales Suárez",
"Isaac Gabriel González Ortega", "Ángela Sofía Guerra Cuadrado",
"Noelis Hernández Ayala", "Alexandra Morales Orozco",
