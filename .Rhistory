library(tidyverse)
library(patchwork)
library(gt)
# 1. Preparar la tabla de referencia
tabla_referencia <- df1 |>
select(evidencia_id, evidencia) |>
distinct() |>
gt() |>
tab_header(title = "Referencias") |>
cols_label(evidencia_id = "Código", evidencia = "Descripción Detallada") |>
# Forzamos el ajuste de texto
tab_style(
style = cell_text(
align = "left",
v_align = "top",
whitespace = "normal"
),
locations = cells_body(columns = evidencia)
) |>
# Fijamos el ancho de la columna de texto para forzar el salto de línea
cols_width(
evidencia ~ px(450),
evidencia_id ~ px(60)
) |>
# IMPORTANTE: Definir que la tabla es de ancho fijo o automático
tab_options(
table.layout = "fixed",
table.font.size = 11,
data_row.padding = px(5)
)
# 2. Crear el gráfico
gr1 <- ggplot(data = df1, aes(x = Porcentaje, y = Evidencia_id)) +
geom_col(fill = "steelblue", width = 0.7) +
theme_minimal() +
labs(x = "% de aciertos", y = "ID Evidencia")
# 3. Combinar
# Aumentamos la proporción del gráfico (0.6) vs tabla (0.4)
# para dar más espacio al texto
gr1 + tabla_referencia + plot_layout(widths = c(0.6, 0.4))
