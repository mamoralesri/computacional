depths_ic <- depth_all_ic
rsec15    <- length(which(depth_all_ic[15] >= depth_all_ic))
mu_rsecs      <- (14 + 1) / 2
var_rsec_ests <- (15 * 15 - 1) / (3 * 15 * 15)
rsec_est15    <- (rsec15 - mu_rsecs) * (2 / 15)
mu0    <- 0
B      <- mu0
lambda <- 0.5
z15    <- min(lambda * rsec_est15 + (1 - lambda) * mu0, B)
L        <- 1.584
var_z15  <- (lambda / (2 - lambda)) * (1 - (1 - lambda)^(2 * 1))
LC1      <- (-L) * sqrt(var_rsec_ests) * sqrt(var_z15)
estim_ic        <- estim[, 1:14]
entra_curva16   <- cbind(estim[, 1:14], estim[, 16])
ord_faseII_16   <- extremdepth(entra_curva16)
ord_all_ic16    <- rep(0, 15)
depth_all_ic16  <- rep(0, 15)
for (i in 1:15) {
ord_all_ic16[i]   <- which(ord_faseII_16$depth.order == i)
depth_all_ic16[i] <- which(ord_faseII_16$depth.order == i) / 15
}
depths_ic16 <- depth_all_ic16
rsec16      <- length(which(depth_all_ic16[15] >= depth_all_ic16))
mu_rsecs      <- (14 + 1) / 2
var_rsec_ests <- (15 * 15 - 1) / (3 * 15 * 15)
rsec_est16    <- (rsec16 - mu_rsecs) * (2 / 15)
mu0    <- 0
B      <- mu0
lambda <- 0.5
z16    <- min(lambda * rsec_est16 + (1 - lambda) * rsec_est15, B)
L        <- 1.584
var_z16  <- (lambda / (2 - lambda)) * (1 - (1 - lambda)^(2 * 2))
LC2      <- (-L) * sqrt(var_rsec_ests) * sqrt(var_z16)
estim_ic        <- estim[, 1:14]
entra_curva17   <- cbind(estim[, 1:14], estim[, 17])
ord_faseII_17   <- extremdepth(entra_curva17)
ord_all_ic17    <- rep(0, 15)
depth_all_ic17  <- rep(0, 15)
for (i in 1:15) {
ord_all_ic17[i]   <- which(ord_faseII_17$depth.order == i)
depth_all_ic17[i] <- which(ord_faseII_17$depth.order == i) / 15
}
depths_ic17 <- depth_all_ic17
rsec17      <- length(which(depth_all_ic17[15] >= depth_all_ic17))
mu_rsecs      <- (14 + 1) / 2
var_rsec_ests <- (15 * 15 - 1) / (3 * 15 * 15)
rsec_est17    <- (rsec17 - mu_rsecs) * (2 / 15)
mu0    <- 0
B      <- mu0
lambda <- 0.5
z17    <- min(lambda * rsec_est17 + (1 - lambda) * rsec_est16, B)
L        <- 1.584
var_z17  <- (lambda / (2 - lambda)) * (1 - (1 - lambda)^(2 * 3))
LC3      <- (-L) * sqrt(var_rsec_ests) * sqrt(var_z17)
estim_ic        <- estim[, 1:14]
entra_curva18   <- cbind(estim[, 1:14], estim[, 18])
ord_faseII_18   <- extremdepth(entra_curva18)
ord_all_ic18    <- rep(0, 15)
depth_all_ic18  <- rep(0, 15)
for (i in 1:15) {
ord_all_ic18[i]   <- which(ord_faseII_18$depth.order == i)
depth_all_ic18[i] <- which(ord_faseII_18$depth.order == i) / 15
}
depths_ic18 <- depth_all_ic18
rsec18      <- length(which(depth_all_ic18[15] >= depth_all_ic18))
mu_rsecs      <- (14 + 1) / 2
var_rsec_ests <- (15 * 15 - 1) / (3 * 15 * 15)
rsec_est18    <- (rsec18 - mu_rsecs) * (2 / 15)
mu0    <- 0
B      <- mu0
lambda <- 0.5
z18    <- min(lambda * rsec_est18 + (1 - lambda) * rsec_est17, B)
L        <- 1.584
var_z18  <- (lambda / (2 - lambda)) * (1 - (1 - lambda)^(2 * 4))
LC4      <- (-L) * sqrt(var_rsec_ests) * sqrt(var_z18)
LC  <- c(LC1, LC2, LC3, LC4)
zs  <- c(z15, z16, z17, z18)
LC
ZS
zs
par(mfrow = c(1, 1))
rango <- range(c(-0.8, 0), zs, LC)
plot(zs, type = "o",
col  = "blue",
ylim = rango,
axes = FALSE,
ann  = FALSE)
axis(1,
at       = 1:4,
lab      = c("2011", "2012", "2013", "2014"),
las      = 2,
cex.axis = 0.9)
axis(2, las = 2, cex.axis = 0.7)
lines(LC, type = "l", lty = 2, col = "red")
box()
title(xlab = "Year",
sub  = "Disaggregated data (a)",
cex.sub = 0.9)
title(ylab = "Charting statistic")
